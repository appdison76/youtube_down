# 로컬 서버용 환경 변수 (Railway와 동일하게 설정)
# 이 파일을 복사해서 .env 로 저장한 뒤, 실제 값을 채워넣으세요.
# 맥에서는 FFMPEG_PATH만 맥 경로로 바꾸거나, ffmpeg가 PATH에 있으면 생략 가능.

# ffmpeg 절대 경로 (PATH에 없을 때만. Railway/Docker는 미설정)
# Windows 예: FFMPEG_PATH=C:/Users/.../ffmpeg.exe
# Mac 예: FFMPEG_PATH=/opt/homebrew/bin/ffmpeg (또는 생략 시 ffmpeg 사용)

# YouTube Data API v3 키 (검색/자동완성에 필요)
# Railway Variables에서 YOUTUBE_API_KEY 값을 복사해서 붙여넣기
YOUTUBE_API_KEY=your_youtube_api_key_here

# Serper (https://serper.dev) — YouTube Data API 쿼터/403 등일 때 검색 폴백. 없으면 기존 동작만.
# SERPER_API_KEY=
# Serper gl/hl (선택). 미설정 시 요청에 포함하지 않음 → Serper 기본(글로벌 앱과 YouTube API 무지역 파라미터와 맞춤).
# SERPER_GL=kr
# SERPER_HL=ko

# 검색 일일 제한 (선택, 기본값 100)
DAILY_LIMIT=50

# ShazamKit (앱용). /api/shazam-token 에서 사용.
# SHAZAM_P8_CONTENT="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# SHAZAM_KEY_ID=FYPT92RXJR
# SHAZAM_TEAM_ID=YQ84HYWRR7

# 웹앱 음악인식 2중화: Shazam 1순위 (RapidAPI). 없으면 ACRCloud만 사용.
# https://rapidapi.com/apidojo/api/shazam 에서 키 발급
# RAPIDAPI_KEY=your_rapidapi_key_here
